VEETEE_ENVIRONMENT=development
VEETEE_HOST=127.0.0.1
VEETEE_PORT=8000
VEETEE_RELOAD=false
VEETEE_LOG_LEVEL=INFO
VEETEE_LOG_JSON=false
VEETEE_MANAGER_API_URL=http://127.0.0.1:8001
VEETEE_MANAGER_INTERNAL_TOKEN=replace-with-the-same-manager-service-token
VEETEE_MANAGER_REQUEST_SECONDS=3
VEETEE_REQUIRE_DEVICE_AUTH=true
VEETEE_REDIS_URL=redis://127.0.0.1:6379/0
VEETEE_TELEMETRY_QUEUE_CAPACITY=256
VEETEE_TELEMETRY_BATCH_SIZE=32
VEETEE_TELEMETRY_FLUSH_SECONDS=0.25
VEETEE_TELEMETRY_SHUTDOWN_SECONDS=1
VEETEE_MEMORY_QUEUE_CAPACITY=128
VEETEE_MEMORY_SHUTDOWN_SECONDS=1
VEETEE_WEBSOCKET_PATH=/veetee/v1/
VEETEE_LAB_WEBSOCKET_PATH=/veetee/lab/v1/
VEETEE_LAB_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
VEETEE_LAB_MAX_SESSIONS=4

# Active local LLM gateway. Keep CLIProxyAPI authenticated and call it over loopback.
VEETEE_CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
VEETEE_CLIPROXY_API_KEY=replace-with-a-dedicated-cliproxy-client-key
VEETEE_CLIPROXY_MODEL=gpt-5.6-terra
# Optional fallback secret for an explicitly selected Groq provider binding.
# Prefer storing the key in Manager's encrypted provider secret field.
VEETEE_GROQ_CLOUD_API_KEY=
VEETEE_LLM_PREWARM=true
VEETEE_LLM_PREWARM_SECONDS=12
VEETEE_PLANNER_SECONDS=15

# VieNeu ONNX is the accepted portable realtime baseline. Native stays an
# explicit benchmark-only profile and never silently replaces this backend.
# This process-wide cap must be present before Python imports NumPy/OpenBLAS.
# VEETEE_TTS_THREADS only limits ONNX Runtime and does not replace this setting.
OPENBLAS_NUM_THREADS=1
VEETEE_MODELS_ROOT=models
VEETEE_ASR_THREADS=2
VEETEE_ASR_SECONDS=8
VEETEE_INPUT_SAMPLE_RATE=16000
VEETEE_INPUT_FRAME_DURATION_MS=60
VEETEE_WIRE_SAMPLE_RATE=24000
VEETEE_WIRE_FRAME_DURATION_MS=60
VEETEE_HELLO_TIMEOUT_SECONDS=10
VEETEE_VAD_THREADS=1
VEETEE_VAD_THRESHOLD=0.5
VEETEE_VAD_RELEASE_THRESHOLD=0.35
VEETEE_VAD_MIN_SILENCE_MS=400
VEETEE_VAD_FAST_SILENCE_MS=320
VEETEE_VAD_FAST_ENDPOINT_MIN_SPEECH_MS=640
VEETEE_VAD_QUIET_PROBABILITY=0.15
VEETEE_VAD_PRE_ROLL_MS=320
VEETEE_TTS_THREADS=2
VEETEE_TTS_BACKEND=onnx
VEETEE_TTS_VOICE="Trúc Ly"
VEETEE_TTS_STYLE=tu_nhien
VEETEE_TTS_SPEED=1.0
VEETEE_TTS_STREAM_LEADIN_FRAMES=16
VEETEE_TTS_OUTPUT_SAMPLE_RATE=24000
VEETEE_TTS_APPLY_WATERMARK=true
VEETEE_TTS_NATIVE_MODEL_DIR=models/vieneu-v3-turbo-native
VEETEE_TTS_NATIVE_LIBRARY_PATH=.cache/local-ai/VieNeu-TTS.cpp/build-cpu/libvieneu-tts.so
VEETEE_TTS_NATIVE_REALTIME_HEADROOM=1.15
VEETEE_TTS_NATIVE_USE_REF_CODES=true
VEETEE_TTS_PLAYBACK_QUEUE_SECONDS=5
VEETEE_DEFAULT_PERSONA="You are Veetee, a natural voice assistant. Reply in the user's language with as much detail as the request needs. Start speaking promptly, continue until the answer is complete, and do not use Markdown or expose hidden reasoning."
VEETEE_MAX_UTTERANCE_SECONDS=0
VEETEE_MAX_UTTERANCE_BUFFER_BYTES=16777216
VEETEE_FIRST_INPUT_SECONDS=180
VEETEE_BETWEEN_TURNS_SECONDS=180
VEETEE_CLOSING_GRACE_SECONDS=5
VEETEE_MAX_SESSION_SECONDS=0
VEETEE_GOODBYE_TEXT="Tạm biệt, hẹn gặp lại."
