{
  "name": "veetee-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc -b --pretty false",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=desktop",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
