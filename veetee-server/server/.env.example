VEETEE_APP_NAME=veetee-server
VEETEE_ENVIRONMENT=local
VEETEE_HOST=127.0.0.1
VEETEE_PORT=8080
VEETEE_LOG_LEVEL=INFO
VEETEE_READINESS_ENABLED=true
VEETEE_DEVICE_GATEWAY_TOKEN=
# Public URL firmware sẽ kết nối WebSocket; mặc định tự suy từ HOST:PORT
# (ws://<host>:<port>/api/v1/devices/ws). Bắt buộc ws/wss, không userinfo,
# không query/fragment. Nên set rõ khi deploy vì host bind có thể khác host public.
VEETEE_DEVICE_WEBSOCKET_PUBLIC_URL=
VEETEE_HELLO_TIMEOUT_SECONDS=10.0
VEETEE_IDLE_TIMEOUT_SECONDS=60.0
VEETEE_PING_INTERVAL_SECONDS=20.0
VEETEE_PONG_TIMEOUT_SECONDS=10.0
VEETEE_JSON_MAX_BYTES=16384
VEETEE_JSON_MAX_DEPTH=8
VEETEE_BINARY_MAX_BYTES=65536
VEETEE_ID_MAX_LENGTH=128
VEETEE_CLEANUP_TIMEOUT_SECONDS=5.0
# Audio primitives (M1.5): bounded ingress/egress queues và downlink pacing.
# Queue vượt audio_max_queue_duration_ms phải >= 60ms (một audio frame);
# audio_pacing_max_drift_ms phải nhỏ hơn audio_max_queue_duration_ms.
VEETEE_AUDIO_MAX_QUEUE_ITEMS=100
VEETEE_AUDIO_MAX_QUEUE_BYTES=1048576
VEETEE_AUDIO_MAX_QUEUE_DURATION_MS=10000.0
VEETEE_AUDIO_PACING_MAX_DRIFT_MS=100.0
# Fake AI pipeline (M1.6): VAD/ASR/LLM/TTS chạy in-process, deterministic,
# không gọi model thật. pipeline_max_utterance_frames phải >= start_frames.
VEETEE_PIPELINE_VAD_SPEECH_THRESHOLD=32.0
VEETEE_PIPELINE_VAD_START_FRAMES=2
VEETEE_PIPELINE_VAD_END_SILENCE_FRAMES=3
VEETEE_PIPELINE_MAX_UTTERANCE_FRAMES=200
VEETEE_PIPELINE_TTS_CHUNKS_PER_SENTENCE=3
# Silero VAD Adapter (M2.1): VAD provider ("fake" hoặc "silero_onnx"), ONNX model path,
# threshold/hysteresis, pre-roll 80ms, min speech 250ms, end silence 150ms, max utterance ms,
# concurrency limiter & admission timeout.
VEETEE_VAD_PROVIDER=fake
VEETEE_VAD_MODEL_PATH=
VEETEE_VAD_THRESHOLD=0.5
VEETEE_VAD_NEG_THRESHOLD=0.35
VEETEE_VAD_PRE_ROLL_MS=80
VEETEE_VAD_MIN_SPEECH_MS=250
VEETEE_VAD_END_SILENCE_MS=150
VEETEE_VAD_MAX_UTTERANCE_MS=12000
VEETEE_VAD_MAX_CONCURRENCY=4
VEETEE_VAD_ADMISSION_TIMEOUT_SECONDS=2.0
# PhoWhisper ASR Adapter (M2.2): ASR provider ("fake" hoặc "pho_whisper"), model id/path,
# device ("cuda", "cpu", "auto"), compute_type ("float16", "int8", "default"), max concurrency 1,
# admission/total timeouts, max audio seconds, language "vi".
VEETEE_ASR_PROVIDER=fake
VEETEE_ASR_MODEL_ID=mad1999/pho-whisper-small-ct2
VEETEE_ASR_DEVICE=cuda
VEETEE_ASR_COMPUTE_TYPE=float16
VEETEE_ASR_MAX_CONCURRENCY=1
VEETEE_ASR_ADMISSION_TIMEOUT_SECONDS=2.0
VEETEE_ASR_TOTAL_TIMEOUT_SECONDS=10.0
VEETEE_ASR_MAX_AUDIO_SECONDS=30.0
VEETEE_ASR_LANGUAGE=vi
VEETEE_ASR_LOCAL_FILES_ONLY=true
# OmniRoute Groq LLM Adapter (M2.3). API key chỉ đặt trong environment/secret local.
VEETEE_LLM_PROVIDER=fake
VEETEE_LLM_OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
VEETEE_LLM_API_KEY=
VEETEE_LLM_OMNIROUTE_MODEL=groq/openai/gpt-oss-120b
VEETEE_LLM_OMNIROUTE_REASONING_EFFORT=low
VEETEE_LLM_CONNECT_TIMEOUT_SECONDS=3.0
VEETEE_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=5.0
VEETEE_LLM_TOTAL_TIMEOUT_SECONDS=30.0
VEETEE_LLM_MAX_CONCURRENCY=4
VEETEE_LLM_ADMISSION_TIMEOUT_SECONDS=2.0
VEETEE_LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
VEETEE_LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=10.0
VEETEE_LLM_MAX_RESPONSE_BYTES=1048576
# Token-to-TTS segmenter (M2.4): đoạn đầu ngắn hơn để giảm first-audio latency.
VEETEE_TTS_SEGMENT_FIRST_MIN_CHARS=24
VEETEE_TTS_SEGMENT_MIN_CHARS=48
VEETEE_TTS_SEGMENT_MAX_CHARS=220
VEETEE_TTS_SEGMENT_MAX_WAIT_SECONDS=0.35
