VEETEE_APP_NAME=veetee-server
VEETEE_ENVIRONMENT=local
VEETEE_HOST=127.0.0.1
VEETEE_PORT=8080
VEETEE_LOG_LEVEL=INFO
VEETEE_READINESS_ENABLED=true
VEETEE_DEVICE_GATEWAY_TOKEN=
# Public URL firmware sẽ kết nối WebSocket; mặc định tự suy từ HOST:PORT
# (ws://<host>:<port>/api/v1/devices/ws). Bắt buộc ws/wss, không userinfo,
# không query/fragment. Nên set rõ khi deploy vì host bind có thể khác host public.
VEETEE_DEVICE_WEBSOCKET_PUBLIC_URL=
VEETEE_HELLO_TIMEOUT_SECONDS=10.0
VEETEE_IDLE_TIMEOUT_SECONDS=60.0
VEETEE_PING_INTERVAL_SECONDS=20.0
VEETEE_PONG_TIMEOUT_SECONDS=10.0
VEETEE_JSON_MAX_BYTES=16384
VEETEE_JSON_MAX_DEPTH=8
VEETEE_BINARY_MAX_BYTES=65536
VEETEE_ID_MAX_LENGTH=128
VEETEE_CLEANUP_TIMEOUT_SECONDS=5.0
# Audio primitives (M1.5): bounded ingress/egress queues và downlink pacing.
# Queue vượt audio_max_queue_duration_ms phải >= 60ms (một audio frame);
# audio_pacing_max_drift_ms phải nhỏ hơn audio_max_queue_duration_ms.
VEETEE_AUDIO_MAX_QUEUE_ITEMS=100
VEETEE_AUDIO_MAX_QUEUE_BYTES=1048576
VEETEE_AUDIO_MAX_QUEUE_DURATION_MS=10000.0
VEETEE_AUDIO_PACING_MAX_DRIFT_MS=100.0
