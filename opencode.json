{
  "$schema": "https://opencode.ai/config.json",
  "model": "cockpit/gpt-5.6-sol",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "veetee-orchestrator",
  "subagent_depth": 1,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 20,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.venv/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/references/**"
    ]
  }
}
